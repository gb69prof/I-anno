[
  {
    "text": "ANTOLOGIA · 01 · MAPPA CONCETTUALE",
    "lines": 1,
    "size": 22,
    "width": 1250
  },
  {
    "text": "Il racconto",
    "lines": 1,
    "size": 34,
    "width": 540
  },
  {
    "text": "organizza",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Eventi",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Una storia collega azioni, persone e conseguenze.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "sono disposti nell’",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Ordine del racconto",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "L’analessi presenta dopo ciò che è accaduto prima.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "sceglie un",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Punto di vista",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "L’accesso alle informazioni orienta il lettore.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "orienta",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Interpretazione",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Una convinzione del personaggio non è automaticamente un fatto.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "prende forma nel",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Mezzo espressivo",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Voce, testo e immagini rendono possibili scelte differenti.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "permette",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Sequenza visiva",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Inquadrature e didascalie costruiscono relazioni.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "ANTOLOGIA · 02 · MAPPA CONCETTUALE",
    "lines": 1,
    "size": 22,
    "width": 1250
  },
  {
    "text": "Il mito",
    "lines": 1,
    "size": 34,
    "width": 540
  },
  {
    "text": "racconta le",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Origini",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Cosmogonia e teogonia raccontano la formazione del mondo divino.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "si rappresentano con",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Genealogie",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Le relazioni “genera” distinguono le discendenze.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "interroga il",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Potere",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "La successione Urano–Crono–Zeus mette in scena conflitti.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "dipende da",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Azioni e alleanze",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Gea, Rea e gli alleati rendono possibili i cambiamenti.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "coinvolge la",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Comunità",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Il piacere del racconto intreccia apprendimento, identità e riti.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "si esprime con",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Immagini e simboli",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Gli attributi rendono riconoscibili figure e relazioni.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "ANTOLOGIA · 03 · MAPPA CONCETTUALE",
    "lines": 1,
    "size": 22,
    "width": 1250
  },
  {
    "text": "Il limite nel racconto",
    "lines": 1,
    "size": 34,
    "width": 540
  },
  {
    "text": "può essere violato dalla",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Hybris",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "La tracotanza diventa un comportamento che umilia o prevarica.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "coinvolge",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Altre persone",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Chi decide può danneggiare anche chi non sceglie.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "si distingue dal",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Rischio",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Un’azione può oltrepassare condizioni da comprendere.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "si osserva in",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Icaro",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Le ali permettono la fuga ma restano fragili.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "emerge dalle",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Conseguenze",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Ogni nesso va ricostruito nel singolo racconto.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "richiedono",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Giudizio",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Sofferenza e colpa non coincidono automaticamente.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "ANTOLOGIA · 04 · MAPPA CONCETTUALE",
    "lines": 1,
    "size": 22,
    "width": 1250
  },
  {
    "text": "Edipo",
    "lines": 1,
    "size": 34,
    "width": 540
  },
  {
    "text": "ignora la propria",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Origine ignorata",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Edipo cresce a Corinto senza conoscere la propria nascita.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "orienta",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Fuga e incontro",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "La volontà di evitare i delitti si fonda su un errore d’identità.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "avvia un’",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Indagine pubblica",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "La peste spinge il re a cercare l’assassino di Laio.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "raccoglie",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Indizi e testimonianze",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Le informazioni si collegano e cambiano il significato del passato.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "giunge al",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Riconoscimento",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Chi indaga scopre di essere al centro della vicenda.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "interroga",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Sapere e responsabilità",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Azioni, intenzioni e conoscenze vanno distinte.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "ANTOLOGIA · 05 · MAPPA CONCETTUALE",
    "lines": 1,
    "size": 22,
    "width": 1250
  },
  {
    "text": "Il conflitto di Antigone",
    "lines": 1,
    "size": 34,
    "width": 540
  },
  {
    "text": "mette alla prova il",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Decreto di Creonte",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "La sicurezza della città giustifica, per il re, il divieto funebre.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "incontra",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Antigone risponde",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Il dovere religioso verso il fratello prevale sul bando.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "si confronta con le",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Voci della città",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Ismene, Emone e Tiresia introducono ragioni e avvertimenti.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "richiedono",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Ascolto e correzione",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Il comando può riconoscere un errore e cambiare.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "conduce a",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Conseguenze",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "La decisione viene corretta quando la tragedia è già avvenuta.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "impongono",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Responsabilità",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Creonte riconosce il costo delle proprie scelte.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "ANTOLOGIA · 06 · MAPPA CONCETTUALE",
    "lines": 1,
    "size": 22,
    "width": 1250
  },
  {
    "text": "Paride: dal desiderio al conflitto",
    "lines": 2,
    "size": 34,
    "width": 540
  },
  {
    "text": "nasce da",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "La contesa",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Eris introduce un premio conteso da tre dee.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "si trasforma in",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Le promesse",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Potere, sapienza e vittoria, amore orientano il giudizio.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "si concentra su",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "La scelta",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Paride assegna la mela ad Afrodite.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "si collega a",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Elena a Troia",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Le tradizioni divergono sul modo della partenza.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "conduce alla",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "La spedizione",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Menelao invoca aiuto e giuramento; Agamennone riunisce i capi.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "costituisce un",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Antefatto iliadico",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "La guerra precede l’inizio del poema sull’ira di Achille.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "ANTOLOGIA · 07 · MAPPA CONCETTUALE",
    "lines": 1,
    "size": 22,
    "width": 1250
  },
  {
    "text": "La scelta di Achille",
    "lines": 1,
    "size": 34,
    "width": 540
  },
  {
    "text": "parte da",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "L’onore ferito",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Agamennone sottrae Briseide e Achille si ritira.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "accende",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "L’ira",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "La ferita personale produce effetti sull’esercito.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "interroga",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "I due destini",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Nel libro IX: fama duratura oppure vita lunga e ritorno.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "comportano",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Una rinuncia",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "I beni delle due possibilità non si possono conservare insieme.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "attraversa",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Il lutto",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "La morte di Patroclo cambia il motivo dell’azione.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "provoca",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Il ritorno in battaglia",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Achille cerca vendetta; poi incontra il dolore di Priamo.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "ANTOLOGIA · 08 · MAPPA CONCETTUALE",
    "lines": 1,
    "size": 22,
    "width": 1250
  },
  {
    "text": "Iliade: dall’ira alla pietà",
    "lines": 1,
    "size": 34,
    "width": 540
  },
  {
    "text": "si apre con",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "La rottura",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "L’offesa di Agamennone provoca il ritiro di Achille.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "espone",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Gli Achei in pericolo",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Le divisioni interne si uniscono alla pressione dei Troiani.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "attraversa",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Il lutto",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "La morte di Patroclo muove Achille alla vendetta.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "conduce alla",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "La morte di Ettore",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "La vittoria non restituisce l’amico né placa il dolore.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "approda alla",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "La supplica",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Priamo richiama il ricordo di Peleo e chiede il figlio.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "rende possibili",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "I funerali di Ettore",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Il corpo torna a Troia: qui il poema si conclude.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "ANTOLOGIA · 09 · MAPPA CONCETTUALE",
    "lines": 1,
    "size": 22,
    "width": 1250
  },
  {
    "text": "Odissea: il ritorno e l’identità",
    "lines": 1,
    "size": 34,
    "width": 540
  },
  {
    "text": "parte da",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "L’assenza",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "A Itaca Telemaco cerca notizie e i Proci occupano la casa.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "apre",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "La Telemachia",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "I primi quattro libri seguono soprattutto il figlio.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "intreccia",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Il viaggio raccontato",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Presso i Feaci Odisseo rievoca le avventure precedenti.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "costruisce",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "L’analessi IX–XII",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Il passato diventa racconto dentro il presente del poema.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "raggiunge",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Itaca ritrovata",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Alleati, lotta e riconoscimenti ricostruiscono la casa.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "richiede",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "La pace finale",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Atena arresta la vendetta dei parenti dei Proci.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "ANTOLOGIA · 10 · MAPPA CONCETTUALE",
    "lines": 1,
    "size": 22,
    "width": 1250
  },
  {
    "text": "Raccontare e scegliere",
    "lines": 1,
    "size": 34,
    "width": 540
  },
  {
    "text": "richiede di",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Leggere e confrontare",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Desideri, ostacoli e conseguenze rendono precisi i confronti.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "cerca",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Le prove nel testo",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Ogni interpretazione richiama un episodio e un dettaglio.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "permette di",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Progettare una scena",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Gesti, oggetti e inquadrature rendono concreto il conflitto.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "costruisce",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Lo storyboard",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Sei scene organizzano una storia visiva originale.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "si completa con",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Motivare e revisionare",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "La lettura di un altro rivela informazioni mancanti o confuse.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "migliora",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Una consegna leggibile",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Tavola, descrizione equivalente e nota spiegano il progetto.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "CITTADINANZA · C1 · MAPPA CONCETTUALE",
    "lines": 1,
    "size": 22,
    "width": 1250
  },
  {
    "text": "Comunicare responsabilmente",
    "lines": 1,
    "size": 34,
    "width": 540
  },
  {
    "text": "verifica",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Informazioni",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Vanno distinte dalle conclusioni che ricaviamo.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "richiedono",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Contesto e fonti",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Permettono di controllare origine, circostanze e parti escluse.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "rende consapevole",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Inquadratura",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Taglio, titolo e gerarchia orientano la lettura.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "può rafforzare",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Stereotipi",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Attribuiscono a un gruppo ciò che un caso non dimostra.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "comporta",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Responsabilità",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "L’autore spiega le scelte e ripara gli errori.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "sostiene",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Attendibilità",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Dipende dalla verifica, non dalla fama o dalle condivisioni.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "CITTADINANZA · C2 · MAPPA CONCETTUALE",
    "lines": 1,
    "size": 22,
    "width": 1250
  },
  {
    "text": "Giudicare con informazioni",
    "lines": 1,
    "size": 34,
    "width": 540
  },
  {
    "text": "esamina",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Indizi",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Suggeriscono spiegazioni, ma va precisato che cosa documentano.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "richiedono",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Fonti e contesto",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Aiutano a distinguere osservazioni, testimonianze e impressioni.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "confronta",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Ipotesi",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Vanno confrontate con dati pertinenti e possibili smentite.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "possono richiedere",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Giudizio sospeso",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Dichiara l’incertezza e indica il controllo successivo.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "attribuisce con ragioni",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Responsabilità",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Riguarda azioni personali, non etichette familiari.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "si distingue dalle",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Conseguenze",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Possono toccare altri senza renderli autori della stessa azione.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "CITTADINANZA · C3 · MAPPA CONCETTUALE",
    "lines": 1,
    "size": 22,
    "width": 1250
  },
  {
    "text": "Dissentire con argomenti",
    "lines": 1,
    "size": 34,
    "width": 540
  },
  {
    "text": "esamina",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Regola",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Ha uno scopo, destinatari ed effetti da esaminare.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "suscita",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Ragioni diverse",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Vanno ricostruite prima di confrontare le alternative.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "distingue",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Forme del dissenso",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Critica, obiezione riconosciuta e disobbedienza sono diverse.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "non coincidono con",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Preferenza personale",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Un gusto non basta da solo a motivare una decisione comune.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "sostiene",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Proposta",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Collega una tesi a informazioni e ragioni pertinenti.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "affronta",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Obiezione e risposta",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Mettono alla prova la proposta senza svalutare le persone.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "CITTADINANZA · C4 · MAPPA CONCETTUALE",
    "lines": 1,
    "size": 22,
    "width": 1250
  },
  {
    "text": "Affrontare il conflitto",
    "lines": 1,
    "size": 34,
    "width": 540
  },
  {
    "text": "esamina",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Scelte",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Trasformano un contrasto in confronto oppure in nuovi danni.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "possono alimentare",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Escalation",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Allarga lo scontro, coinvolgendo reputazione e pubblico.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "chiarisce",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Promesse",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Creano aspettative e richiedono contenuti chiari.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "sostengono",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Fiducia",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Cresce se gli impegni sono verificabili e gli errori correggibili.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "riconosce",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Dignità dell’altro",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Permette di criticare azioni senza cancellare la persona.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "orienta la",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Riparazione",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Affronta un danno preciso; la ritorsione ne produce un altro.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "CITTADINANZA · C5 · MAPPA CONCETTUALE",
    "lines": 1,
    "size": 22,
    "width": 1250
  },
  {
    "text": "Entrare in una comunità",
    "lines": 1,
    "size": 34,
    "width": 540
  },
  {
    "text": "richiede",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Accoglienza",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Offre aiuto e rende comprensibili spazi, regole e strumenti.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "può aprire alla",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Partecipazione",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Permette di contribuire attraverso possibilità e ruoli concreti.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "incontra",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Identità",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Comprende aspetti diversi e non si esaurisce in un’etichetta.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "trova voce nell’",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Autorappresentazione",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Dà forma agli aspetti di sé che una persona vuole condividere.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "costruisce",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Riconoscimento",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "Dà spazio alla voce e al contributo della persona.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "sostiene l’",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Appartenenza plurale",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "Si può partecipare a più gruppi mantenendo differenze personali.",
    "lines": 3,
    "size": 24,
    "width": 350
  },
  {
    "text": "ANTOLOGIA E CITTADINANZA · PRIMA · MAPPA CONCETTUALE",
    "lines": 1,
    "size": 22,
    "width": 1250
  },
  {
    "text": "Racconti, miti e scelte",
    "lines": 1,
    "size": 34,
    "width": 540
  },
  {
    "text": "imparare a",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Narrare",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "01–02 · Racconto, media e funzioni del mito.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "apre domande sul",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Comunicare",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "C1 · Modelli, stereotipi e responsabilità.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "permette di",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Leggere il limite",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "03–05 · Hybris, Edipo e Antigone.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "si confronta con",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Prove e dissenso",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "C2–C3 · Giudizio, leggi e argomentazione.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "aiuta a discutere",
    "lines": 1,
    "size": 25,
    "width": 390
  },
  {
    "text": "Scegliere e tornare",
    "lines": 1,
    "size": 29,
    "width": 352
  },
  {
    "text": "06–10 · Troia, eroi e narrazione visiva.",
    "lines": 2,
    "size": 24,
    "width": 350
  },
  {
    "text": "interroga",
    "lines": 1,
    "size": 24,
    "width": 384
  },
  {
    "text": "Conflitto e identità",
    "lines": 1,
    "size": 28,
    "width": 352
  },
  {
    "text": "C4–C5 · Umanità, ospitalità, riconoscimento.",
    "lines": 2,
    "size": 24,
    "width": 350
  }
]